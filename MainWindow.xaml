<Window x:Class="AdvancedFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced File Explorer" Height="740" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#181818" Foreground="White">
    <Window.DataContext><vm:MainViewModel xmlns:vm="clr-namespace:AdvancedFileExplorer.ViewModels"/></Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding BackCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Modifiers="Control" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Control" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding PasteCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Tag="{Binding}" Click="Tab_Click" Margin="4" Padding="12,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="1" Background="#232323" Margin="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="←" Command="{Binding BackCommand}" Width="38"/>
                <Button Content="→" Command="{Binding ForwardCommand}" Width="38"/>
                <Button Content="↑" Command="{Binding UpCommand}" Width="38"/>
                <Button Content="⟳" Command="{Binding RefreshCommand}" Width="38"/>
            </StackPanel>
            <TextBox x:Name="txtAddressInput" Grid.Column="1" Text="{Binding AddressInputText, UpdateSourceTrigger=PropertyChanged}" KeyDown="txtAddressInput_KeyDown" Margin="8,5"/>
            <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="8,5"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Background="#1F1F1F">
                <TextBlock Text="Quick Access" FontSize="16" FontWeight="Bold" Margin="12"/>
                <ListBox ItemsSource="{Binding QuickAccessItems}" SelectionChanged="QuickAccess_SelectionChanged" Margin="8">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Padding="8"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Drives" FontSize="16" FontWeight="Bold" Margin="12,18,12,8"/>
                <ListBox ItemsSource="{Binding Drives}" MouseDoubleClick="DriveItem_DoubleClick" Margin="8">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Padding="8"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <Grid Grid.Column="1" Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="4">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding FullPath}" Margin="2"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ListView Grid.Row="1" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" MouseDoubleClick="FilesList_MouseDoubleClick">
                    <ListView.View><GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="260"/>
                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding FileType}" Width="150"/>
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding FormattedSize}" Width="100"/>
                        <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding FormattedDate}" Width="150"/>
                    </GridView></ListView.View>
                </ListView>
            </Grid>
            <Border Grid.Column="2" Background="#232323" Margin="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Preview" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PreviewType}" Foreground="#4CC2FF" Margin="0,6,0,12"/>
                        <Image Source="{Binding PreviewImagePath}" Height="180" Stretch="Uniform" Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#CCCCCC"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#141414" Padding="10,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusText}"/><TextBlock Text="{Binding SelectionStatusText}" Margin="20,0,0,0"/></StackPanel>
        </Border>
    </Grid>
</Window>