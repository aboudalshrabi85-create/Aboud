<Window x:Class="AdvancedFileExplorer.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties" Height="490" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#202020" Foreground="#EEEEEE">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" Background="#2C2C2C" CornerRadius="6">
                <Path x:Name="pathHeaderIcon" Stretch="Uniform" Width="24" Height="24" Fill="#0078D4" Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
            </Border>
            <TextBox x:Name="txtName" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Background="#2B2B2B" Foreground="White" Padding="6,2"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Type:" Foreground="#AAAAAA" Margin="0,4"/>
                <TextBlock x:Name="lblType" Grid.Row="0" Grid.Column="1" Foreground="White" Margin="0,4"/>
                <TextBlock Grid.Row="1" Text="Location:" Foreground="#AAAAAA" Margin="0,4"/>
                <TextBlock x:Name="lblLocation" Grid.Row="1" Grid.Column="1" Foreground="White" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="Size:" Foreground="#AAAAAA" Margin="0,4"/>
                <TextBlock x:Name="lblSize" Grid.Row="2" Grid.Column="1" Foreground="White" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Grid.Row="3" Text="Created:" Foreground="#AAAAAA" Margin="0,4"/>
                <TextBlock x:Name="lblCreated" Grid.Row="3" Grid.Column="1" Foreground="White" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Grid.Row="4" Text="Modified:" Foreground="#AAAAAA" Margin="0,4"/>
                <TextBlock x:Name="lblModified" Grid.Row="4" Grid.Column="1" Foreground="White" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Grid.Row="5" Text="Accessed:" Foreground="#AAAAAA" Margin="0,4"/>
                <TextBlock x:Name="lblAccessed" Grid.Row="5" Grid.Column="1" Foreground="White" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Grid.Row="6" Text="Attributes:" Foreground="#AAAAAA" Margin="0,4"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="chkReadOnly" Content="Read-only" Foreground="White" Margin="0,4,16,4"/>
                    <CheckBox x:Name="chkHidden" Content="Hidden" Foreground="White" Margin="0,4"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="80" Height="30" Margin="0,0,8,0" Click="btnOk_Click"/>
            <Button Content="Cancel" Width="80" Height="30" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>